# Supabase — from Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public origin of the deployed site. Used for canonical URLs, sitemap.xml and
# robots.txt. Without it these fall back to http://localhost:3000, which is
# wrong in production — set this in the Vercel project settings.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
